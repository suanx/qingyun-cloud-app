<?xml version="1.0" encoding="utf-8"?>
<!-- 轻云启动图标背景：方案 A 的 125° 蓝 -> 薄荷渐变。
     Android gradient angle 315 = 左上到右下（TL_BR），对应 CSS 125deg。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:type="linear"
        android:startColor="#FF2F6BFF"
        android:centerColor="#FF4E8BFF"
        android:endColor="#FF37C9B4" />
</shape>
